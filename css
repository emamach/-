
/* =========================================
   دجاج اليمامة - التصميم الرئيسي
   ========================================= */

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  direction: rtl;
  scroll-behavior: smooth;
}

body {
  font-family:
    Arial,
    Tahoma,
    "Noto Sans Arabic",
    sans-serif;

  background:
    linear-gradient(
      180deg,
      #66afe9 0%,
      #3f91d1 45%,
      #1d65aa 100%
    );

  color: #ffffff;
  min-height: 100vh;
}

/* =========================================
   الشريط المتحرك
   ========================================= */

.ticker-wrap {
  width: 100%;
  height: 36px;
  overflow: hidden;
  background: #0c3e72;
  color: #ffffff;
  line-height: 36px;
  white-space: nowrap;
  font-size: 14px;
  font-weight: bold;
}

.ticker {
  display: inline-block;
  padding-right: 100%;
  animation: yamamaTicker 18s linear infinite;
}

@keyframes yamamaTicker {
  0% {
    transform: translateX(0);
  }

  100% {
    transform: translateX(-100%);
  }
}

/* =========================================
   الهيدر
   ========================================= */

header {
  position: relative;
  text-align: center;
  padding: 15px 12px 8px;
}

.brand {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.brand-logo {
  width: 105px;
  height: 105px;
  object-fit: contain;
  margin: -5px 0 -5px;
  filter: drop-shadow(
    0 4px 5px rgba(0, 0, 0, 0.18)
  );
}

.brand-title {
  font-size: 30px;
  font-weight: 900;
  line-height: 1.1;
  text-shadow:
    0 2px 5px rgba(0, 0, 0, 0.2);
}

.brand-subtitle {
  width: 78%;
  margin-top: 7px;
  padding-bottom: 7px;
  border-bottom:
    1px solid rgba(255, 255, 255, 0.45);

  font-size: 25px;
  font-weight: bold;
}

/* =========================================
   زر المحادثة
   ========================================= */

.chat-top-button {
  position: absolute;
  right: 12px;
  top: 14px;

  border:
    1px solid rgba(255, 255, 255, 0.9);

  background:
    rgba(255, 255, 255, 0.17);

  color: #ffffff;

  border-radius: 22px;

  padding: 8px 12px;

  font-size: 12px;
  font-weight: bold;

  cursor: pointer;

  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
}

/* =========================================
   شبكة المنتجات
   ========================================= */

.products-grid {
  width: 100%;
  max-width: 680px;
  margin: auto;

  padding:
    8px 12px 20px;

  display: grid;

  grid-template-columns:
    repeat(2, minmax(0, 1fr));

  gap: 10px;
}

/* =========================================
   بطاقة المنتج
   ========================================= */

.product-card {
  min-height: 270px;

  padding: 10px;

  border-radius: 17px;

  border:
    1px solid rgba(255, 255, 255, 0.55);

  background:
    rgba(255, 255, 255, 0.17);

  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);

  box-shadow:
    0 5px 12px rgba(0, 0, 0, 0.09);

  display: flex;
  flex-direction: column;
  justify-content: space-between;

  overflow: hidden;
}

/* =========================================
   أعلى البطاقة
   ========================================= */

.product-top {
  display: grid;

  grid-template-columns:
    0.9fr 1.1fr;

  gap: 5px;

  align-items: center;
}

.product-info {
  text-align: right;
}

.product-name {
  font-size: 16px;
  font-weight: bold;
  line-height: 1.35;

  margin-bottom: 5px;
}

.product-fresh {
  font-size: 11px;
  opacity: 0.9;
}

/* =========================================
   صورة المنتج
   ========================================= */

.product-image-box {
  width: 100%;
  height: 108px;

  display: flex;
  align-items: center;
  justify-content: center;
}

.product-image {
  width: 100%;
  height: 100%;

  object-fit: contain;

  filter:
    drop-shadow(
      0 5px 5px rgba(0, 0, 0, 0.18)
    );
}

.product-placeholder {
  font-size: 45px;
  opacity: 0.8;
}

/* =========================================
   السعر
   ========================================= */

.price-title {
  text-align: right;

  font-size: 11px;

  margin:
    2px 4px 4px;
}

.product-price {
  width: 100%;

  background: #ffffff;

  color: #2168a7;

  border-radius: 9px;

  padding: 7px 9px;

  text-align: right;

  font-size: 17px;

  font-weight: 900;

  direction: rtl;

  margin-bottom: 8px;
}

/* =========================================
   زر الطلب
   ========================================= */

.order-button {
  width: 100%;

  border: none;

  border-radius: 22px;

  background:
    linear-gradient(
      180deg,
      #1873bd,
      #105b9b
    );

  color: #ffffff;

  padding: 9px 5px;

  font-size: 16px;

  font-weight: bold;

  cursor: pointer;

  box-shadow:
    0 2px 5px rgba(0, 0, 0, 0.14);

  transition:
    transform 0.15s,
    opacity 0.15s;
}

.order-button:active {
  transform: scale(0.97);
}

.order-button:hover {
  opacity: 0.93;
}

/* =========================================
   أسفل الصفحة
   ========================================= */

.footer {
  background: rgba(255, 255, 255, 0.96);

  color: #205b91;

  border-radius:
    55px 55px 0 0;

  text-align: center;

  padding:
    22px 10px 18px;

  margin-top: 5px;
}

.footer-title {
  font-size: 17px;
  font-weight: bold;
}

.footer-phone {
  direction: ltr;

  font-size: 24px;

  font-weight: 900;

  margin-top: 3px;
}

/* =========================================
   نافذة المحادثة
   ========================================= */

.chat-modal {
  display: none;

  position: fixed;

  inset: 0;

  z-index: 1000;

  background:
    rgba(0, 0, 0, 0.55);

  align-items: flex-end;
}

.chat-modal.active {
  display: flex;
}

.chat-box {
  width: 100%;

  max-width: 680px;

  height: 75vh;

  margin: auto;

  background: #f4f6f8;

  color: #222222;

  border-radius:
    22px 22px 0 0;

  display: flex;

  flex-direction: column;

  overflow: hidden;
}

.chat-header {
  background: #15588f;

  color: #ffffff;

  padding: 15px;

  display: flex;

  justify-content: space-between;

  align-items: center;

  font-weight: bold;
}

.chat-close {
  cursor: pointer;

  font-size: 20px;
}

.chat-body {
  flex: 1;

  overflow-y: auto;

  padding: 14px;
}

.chat-bubble {
  max-width: 82%;

  padding: 10px 14px;

  border-radius: 14px;

  margin-bottom: 9px;

  font-size: 14px;

  line-height: 1.6;
}

.chat-bubble.customer {
  background: #1671ba;

  color: #ffffff;

  margin-right: auto;
}

.chat-bubble.manager {
  background: #dfeaf5;

  color: #174b76;

  margin-left: auto;
}

/* =========================================
   شاشة الطلب
   ========================================= */

.order-overlay {
  display: none;

  position: fixed;

  inset: 0;

  z-index: 1100;

  background:
    rgba(0, 0, 0, 0.55);

  align-items: center;

  justify-content: center;

  padding: 15px;
}

.order-overlay.active {
  display: flex;
}

.order-box {
  width: 100%;

  max-width: 520px;

  max-height: 92vh;

  overflow-y: auto;

  background: #ffffff;

  color: #173d60;

  border-radius: 18px;

  padding: 18px;

  box-shadow:
    0 10px 35px rgba(0, 0, 0, 0.25);
}

.order-title {
  font-size: 20px;

  font-weight: bold;

  color: #155b96;

  margin-bottom: 14px;
}

/* =========================================
   الحقول
   ========================================= */

.form-group {
  margin-bottom: 12px;
}

.form-group label {
  display: block;

  font-size: 13px;

  font-weight: bold;

  margin-bottom: 5px;
}

.form-group input,
.form-group textarea,
.form-group select {
  width: 100%;

  border:
    1px solid #ccd9e4;

  border-radius: 9px;

  padding: 11px;

  font-size: 15px;

  outline: none;

  background: #ffffff;

  color: #173d60;
}

.form-group textarea {
  min-height: 80px;

  resize: vertical;
}

.form-group input:focus,
.form-group textarea:focus {
  border-color: #1976bd;
}

/* =========================================
   الموقع
   ========================================= */

.location-box {
  background: #eef7ff;

  border:
    1px solid #c9e2f6;

  color: #155b96;

  border-radius: 10px;

  padding: 11px;

  margin-bottom: 12px;

  font-size: 13px;
}

.location-success {
  color: #2e7d32;

  font-weight: bold;
}

/* =========================================
   أزرار النموذج
   ========================================= */

.primary-button {
  width: 100%;

  background: #176db4;

  color: #ffffff;

  border: none;

  border-radius: 10px;

  padding: 12px;

  font-size: 16px;

  font-weight: bold;

  cursor: pointer;
}

.secondary-button {
  width: 100%;

  background: #edf2f6;

  color: #285777;

  border: none;

  border-radius: 10px;

  padding: 11px;

  font-size: 14px;

  font-weight: bold;

  cursor: pointer;

  margin-top: 8px;
}

/* =========================================
   شاشة التتبع
   ========================================= */

.tracking-box {
  background: #ffffff;

  color: #173d60;

  border-radius: 18px;

  padding: 18px;

  margin: 15px auto;

  max-width: 600px;
}

.tracking-title {
  color: #155b96;

  font-size: 20px;

  font-weight: bold;

  margin-bottom: 18px;
}

.tracking-step {
  display: flex;

  align-items: center;

  gap: 10px;

  padding: 11px 0;

  border-bottom:
    1px solid #e7edf2;
}

.tracking-icon {
  width: 30px;

  height: 30px;

  border-radius: 50%;

  display: flex;

  align-items: center;

  justify-content: center;

  background: #dfe9f1;

  color: #6c8498;

  font-weight: bold;
}

.tracking-step.active .tracking-icon,
.tracking-step.done .tracking-icon {
  background: #1976bd;

  color: #ffffff;
}

.tracking-step.active,
.tracking-step.done {
  font-weight: bold;

  color: #155b96;
}

/* =========================================
   عامل التوصيل
   ========================================= */

.driver-card {
  background: #f0f7fc;

  border:
    1px solid #d3e5f2;

  border-radius: 12px;

  padding: 13px;

  margin-top: 12px;

  color: #174b76;
}

.driver-name {
  font-weight: bold;

  font-size: 16px;

  margin-bottom: 5px;
}

.call-driver {
  display: block;

  text-align: center;

  text-decoration: none;

  background: #2e7d32;

  color: #ffffff;

  padding: 10px;

  border-radius: 9px;

  margin-top: 10px;

  font-weight: bold;
}

/* =========================================
   البث
   ========================================= */

.stream-overlay {
  display: none;

  position: fixed;

  inset: 0;

  z-index: 2000;

  background: #000000;

  padding: 10px;

  flex-direction: column;

  align-items: center;

  justify-content: center;
}

.stream-overlay.active {
  display: flex;
}

.stream-timer {
  color: #ff5252;

  font-size: 17px;

  font-weight: bold;

  margin-bottom: 10px;
}

.camera-grid {
  width: 100%;

  max-width: 700px;

  display: grid;

  grid-template-columns: 1fr;

  gap: 10px;
}

.camera-frame {
  height: 190px;

  background: #111111;

  border:
    1px solid #333333;

  border-radius: 10px;

  overflow: hidden;
}

.camera-frame iframe,
.camera-frame video,
.camera-frame img {
  width: 100%;

  height: 100%;

  border: none;

  object-fit: cover;
}

.close-stream {
  margin-top: 14px;

  background: #c62828;

  color: #ffffff;

  border: none;

  border-radius: 8px;

  padding: 10px 25px;

  font-weight: bold;

  cursor: pointer;
}

/* =========================================
   رسائل التنبيه
   ========================================= */

.toast {
  position: fixed;

  bottom: 20px;

  left: 50%;

  transform:
    translateX(-50%)
    translateY(100px);

  background: #173f66;

  color: #ffffff;

  padding: 11px 18px;

  border-radius: 10px;

  z-index: 5000;

  font-size: 13px;

  opacity: 0;

  transition:
    opacity 0.25s,
    transform 0.25s;
}

.toast.show {
  opacity: 1;

  transform:
    translateX(-50%)
    translateY(0);
}

/* =========================================
   أجهزة صغيرة
   ========================================= */

@media (max-width: 380px) {

  .brand-title {
    font-size: 26px;
  }

  .brand-logo {
    width: 90px;
    height: 90px;
  }

  .brand-subtitle {
    font-size: 22px;
  }

  .product-card {
    min-height: 245px;
  }

  .product-name {
    font-size: 14px;
  }

  .product-image-box {
    height: 92px;
  }

  .product-price {
    font-size: 15px;
  }

  .order-button {
    font-size: 15px;
  }

}

/* =========================================
   الأجهزة الكبيرة
   ========================================= */

@media (min-width: 700px) {

  .products-grid {
    gap: 14px;
  }

  .product-card {
    min-height: 290px;
  }

  .product-image-box {
    height: 125px;
  }

}
/* =========================================
   لوحة إدارة دجاج اليمامة
   ========================================= */

.admin-container {
  width: 100%;
  max-width: 600px;
  margin: 0 auto;
  padding: 20px 14px 50px;
}

.admin-header {
  text-align: center;
  margin-bottom: 20px;
}

.admin-logo {
  width: 90px;
  height: 90px;
  object-fit: contain;
  border-radius: 20px;
  margin-bottom: 10px;
}

.admin-header h1 {
  font-size: 1.6rem;
  margin-bottom: 6px;
}

.admin-header p {
  opacity: 0.9;
}

.admin-section {
  background: rgba(255,255,255,0.96);
  color: #17324d;
  border-radius: 18px;
  padding: 18px;
  margin-bottom: 16px;
  box-shadow: 0 8px 25px rgba(0,0,0,0.12);
}

.admin-section h2 {
  margin-bottom: 14px;
  font-size: 1.15rem;
  color: #154c8a;
}

.admin-section label {
  display: block;
  margin-top: 8px;
  margin-bottom: 5px;
  font-weight: 700;
}

.admin-section input {
  width: 100%;
  padding: 12px;
  border: 1px solid #ccd6df;
  border-radius: 10px;
  margin-bottom: 8px;
  font-size: 1rem;
  outline: none;
}

.admin-section input:focus {
  border-color: #1769aa;
  box-shadow: 0 0 0 3px rgba(23,105,170,0.12);
}

.primary-button,
.secondary-button,
.logout-button,
.delete-button {
  width: 100%;
  border: none;
  border-radius: 10px;
  padding: 12px;
  margin-top: 8px;
  font-size: 0.95rem;
  font-weight: 700;
  cursor: pointer;
}

.primary-button {
  background: #1769aa;
  color: white;
}

.secondary-button {
  background: #e8f1f8;
  color: #154c8a;
}

.logout-button {
  background: #263238;
  color: white;
  margin-bottom: 8px;
}

.delete-button {
  background: #c62828;
  color: white;
}

.admin-message {
  margin-top: 10px;
  color: #c62828;
  font-weight: 700;
}

.admin-help {
  font-size: 0.85rem;
  color: #607d8b;
  margin-bottom: 12px;
}


/* =========================================
   بطاقات المنتجات داخل الإدارة
   ========================================= */

.admin-products {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.admin-product-item {
  background: #f4f7fa;
  border: 1px solid #d9e2ea;
  border-radius: 15px;
  padding: 14px;
}

.admin-product-item label {
  color: #37474f;
}

.admin-product-preview-box {
  width: 100%;
  height: 170px;
  background: #e9eef3;
  border-radius: 12px;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12px;
}

.admin-product-preview {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.admin-no-image {
  color: #78909c;
  font-weight: 700;
  text-align: center;
}


/* =========================================
   زر اختيار الصورة من الهاتف
   ========================================= */

.image-upload-button {
  display: flex !important;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 48px;
  background: #e3f2fd;
  color: #1565c0 !important;
  border: 2px dashed #64b5f6;
  border-radius: 12px;
  margin-top: 10px !important;
  margin-bottom: 8px !important;
  cursor: pointer;
  font-weight: 800 !important;
}

.image-upload-button:active {
  transform: scale(0.98);
}


/* =========================================
   الهواتف
   ========================================= */

@media (max-width: 480px) {

  .admin-container {
    padding: 14px 10px 40px;
  }

  .admin-section {
    padding: 14px;
    border-radius: 15px;
  }

  .admin-product-preview-box {
    height: 150px;
  }

}


/* =========================================
   الأجهزة الأكبر
   ========================================= */

@media (min-width: 700px) {

  .admin-container {
    max-width: 650px;
  }

}
